# ⚠️ Data pribadi — JANGAN pernah di-upload.
# dummy.jpeg = daftar penilaian siswa (nama + nilai). Bukan aset website.
# Prefix "/" supaya hanya cocok di root, bukan di dalam src/.
/dummy.jpeg

# Duplikat di ROOT saja. Prefix "/" wajib: tanpa itu pola ini cocok di
# semua level direktori dan ikut membuang src/assets/images/logo.jpeg —
# yang justru dibutuhkan saat build (ENOENT).
/logo.jpeg
/12rpl.jpeg

# Skrip pengembangan — tidak diperlukan saat build Vercel.
# (favicon PNG sebaiknya di-generate lokal lalu di-commit)
# Prefix "/" supaya tidak ikut membuang folder bernama "scripts"
# di dalam src/ kalau nanti ada.
/scripts

